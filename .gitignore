# ============================================================
# MiniEngine .gitignore
# 目标：家里 / 公司两台机器同步，任何"本机生成物"都不进仓库
# ============================================================

# ---- 构建产物（CMake + VS 生成器）----
build/
build-*/
out/
bin/
obj/
[Oo]bj/

# ---- S11.5：demo 打包产物（zip 走 Release 资产 / 手动传，二进制不进仓库）----
dist/

# ---- study/ 下的论文副本（2026-10-16）：第三方版权材料 ⇒ 本地保存、不入库 ----
# 出处与链接写在 study/RAYCASTING_NOTES.md §7（正文只放"出处 + 链接"，不复制原文）
study/papers/*.pdf

# ---- CMake ----
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
Testing/
# 本机私有预设（含绝对路径），绝不提交
# ⚠️ 规则行必须是独立的一行：git 不支持行尾注释，
#    写成 `CMakeUserPresets.json   # 说明` 会让整行变成一个匹配不到任何文件的 pattern（2026-10-08 修）
CMakeUserPresets.json

# ---- 编译器 / 链接器中间产物 ----
*.obj
*.o
*.exe
*.pdb
*.ilk
*.idb
*.exp
*.lib
*.dll
*.so
*.dylib
*.a

# ---- Visual Studio ----
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user

# ---- 编辑器：只忽略本机私有项，保留可共享的调试配置 ----
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
*.swp
*~

# ---- 系统 ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- 日志 / 临时 ----
*.log
*.tmp
*.bak
*.orig
*.rej

# ---- 本机私有笔记（不参与同步）----
NOTES.local.md
*.local
