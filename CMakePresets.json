{
  "version": 6,
  "configurePresets": [
    {
      "name": "ms-msvc-debug",
      "displayName": "MSVC (Visual Studio 17 2022)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_CONFIGURATION_TYPES": "Debug;Release" }
    },
    {
      "name": "ms-asan",
      "displayName": "MSVC + AddressSanitizer",
      "inherits": "ms-msvc-debug",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": { "MINI_SANITIZE": "ON" }
    },
    {
      "name": "ms-msvc-release-static",
      "displayName": "MSVC Release + 静态 CRT（可分发，S11.5 demo 用）",
      "inherits": "ms-msvc-debug",
      "binaryDir": "${sourceDir}/build-demo",
      "cacheVariables": { "MINI_STATIC_CRT": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "ms-msvc-debug", "configuration": "Debug" },
    { "name": "release", "configurePreset": "ms-msvc-debug", "configuration": "Release" },
    { "name": "asan",    "configurePreset": "ms-asan",       "configuration": "Debug" },
    { "name": "release-static", "configurePreset": "ms-msvc-release-static", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "ms-msvc-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "ms-msvc-debug",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "ms-asan",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release-static",
      "configurePreset": "ms-msvc-release-static",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
