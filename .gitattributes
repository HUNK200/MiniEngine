# ============================================================
# MiniEngine .gitattributes
# 目的：让"家里"和"公司"两台机器得到字节一致的工作区，
#       免疫 core.autocrlf 等本机设置（Git for Windows 默认 autocrlf=true）
# ============================================================

# 所有文本文件：入库统一 LF，检出到工作区也统一 LF
* text=auto eol=lf

# Windows 批处理对 LF 不友好，必须 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 源码与文档显式声明（规则同上，写出来是为了可读、可改）
*.cpp   text eol=lf
*.cc    text eol=lf
*.cxx   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.inl   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# 二进制：禁止任何换行转换，禁止 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.bmp   binary
*.ttf   binary
*.zip   binary

# GitHub 语言统计：文档不计入语言占比，让仓库显示为 C++
*.md   linguist-documentation
